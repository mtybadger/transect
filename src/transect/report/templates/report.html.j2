<!DOCTYPE html>
<html><head><meta charset="utf-8">
<title>{{ title }}</title>
<link rel="icon" type="image/png" href="{{ favicon_uri }}">
<style>{{ style }}</style>
</head><body{% if sensitivity %} class="classified"{% endif %}>
{%- if sensitivity %}
{#- Protective marking at top and bottom of the viewport - the
    digital analogue of the marking on every page; position:fixed
    also repeats on each printed page. -#}
<div class="sensitivity-banner sensitivity-top">{{ sensitivity }}</div>
<div class="sensitivity-banner sensitivity-bottom">{{ sensitivity }}</div>
{%- endif %}
<h1><img class="brand-logo" src="{{ logo_uri }}" alt=""> {{ title }}</h1>
<p class="meta">scan: {{ scan_location }} · {{ n_transcripts }} transcript(s)</p>
{%- if scan_status_view.failures %}
<p class="warning flag">&#9888; Some requested scanners failed or have missing coverage - see <a href="#scan-status">Scan execution &amp; coverage</a>.</p>
{%- endif %}
{#- Fit-to-window is the default view; this checkbox opts into the
    zoomed-in, horizontally-scrollable variant - full per-turn pixel
    resolution for laptop-screen reading. -#}
<p class="meta"><label title="Renders each chart at its full authored width (higher per-turn resolution) inside a horizontal scroll box, instead of scaling it down to fit the window."><input type="checkbox" id="transect-zoom-toggle" onchange="_transectApplyFit()"> zoomed-in charts (scroll horizontally)</label></p>
{% if not transcripts %}<p>No transcripts in results.</p>{% endif %}
{%- if transcripts|length > 1 %}
{#- Lane navigation: one chip per report unit (the episode first, then
    each lane). A click opens that unit and scrolls to it; the chips
    stay at the top of the viewport. -#}
<nav class="lane-nav" aria-label="Report units">
{%- for t in transcripts %}<a href="#{{ t.anchor }}" onclick="_transectOpenUnit('{{ t.anchor }}')">{{ t.nav_label }}</a>{% endfor %}
<button type="button" onclick="_transectToggleUnits(true)">expand all</button><button type="button" onclick="_transectToggleUnits(false)">collapse all</button>
</nav>
{%- endif %}
{% for t in transcripts %}
<details class="transcript" id="{{ t.anchor }}"{% if t.open %} open{% endif %}>
<summary><span class="unit-marker" aria-hidden="true"></span><h2>{{ t.heading }}</h2></summary>
{% if t.run_meta %}{{ t.run_meta }}{% endif %}
{% for section in t.sections %}{{ section }}{% endfor %}
</details>
{% endfor %}
{% include "scan_status.html.j2" %}
{#- Provenance footer: the mark, the producing package + version,
    and the repo - the report itself carries its attribution. -#}
<footer class="report-footer"><img src="{{ logo_uri }}" alt=""><span>Produced with Transect v{{ package_version }} · <a href="https://github.com/AI-Safety-Institute/transect">github.com/AI-Safety-Institute/transect</a></span></footer>
{#- Fixed bottom-right "Back to top": the way back after a band click
    jumps the reader to a phase card. Hidden until they have scrolled a
    screen. -#}
<button id="transect-back-top" onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Back to the top of the page">&uarr; Back to top</button>
<script>
// Chart iframes load lazily: each carries its document in
// data-transect-srcdoc; it is copied into srcdoc when the iframe comes
// within _LAZY_MARGIN of the viewport and removed again once the iframe
// is far away, so at most _LAZY_LIVE chart runtimes exist at a time
// (every srcdoc document boots its own Mosaic/DuckDB instance). A
// collapsed <details> keeps its iframes unloaded.
var _LAZY_LIVE = 6;
var _transectVisibleFrames = new Set();
var _transectLiveFrames = [];
function _transectLoadFrame(frame) {
  if (frame.getAttribute("srcdoc")) return;
  frame.setAttribute("srcdoc", frame.getAttribute("data-transect-srcdoc"));
  frame.classList.remove("transect-lazy");
  _transectLiveFrames.push(frame);
  while (_transectLiveFrames.length > _LAZY_LIVE) {
    var idle = _transectLiveFrames.findIndex(function(f) { return !_transectVisibleFrames.has(f); });
    if (idle < 0) break;
    var old = _transectLiveFrames.splice(idle, 1)[0];
    old.removeAttribute("srcdoc");
    old.classList.add("transect-lazy");
  }
}
function _transectWatchFrames() {
  var frames = document.querySelectorAll("iframe[data-transect-srcdoc]");
  if (!("IntersectionObserver" in window)) {
    frames.forEach(_transectLoadFrame);
    return;
  }
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) { _transectVisibleFrames.add(e.target); _transectLoadFrame(e.target); }
      else { _transectVisibleFrames.delete(e.target); }
    });
    _transectQueueFit();
  }, {rootMargin: "600px 0px"});
  frames.forEach(function(f) { io.observe(f); });
}
document.addEventListener("DOMContentLoaded", _transectWatchFrames);

// Report units (<details class="transcript">): the lane navigation
// opens a unit before jumping to it; expand/collapse all toggles every
// unit (an opened unit's charts load as they scroll into view).
function _transectOpenUnit(id) {
  var unit = document.getElementById(id);
  if (unit && unit.tagName === "DETAILS") unit.open = true;
}
function _transectToggleUnits(open) {
  document.querySelectorAll("details.transcript").forEach(function(d) { d.open = open; });
  _transectQueueFit();
}
// a phase-card deep link into a collapsed lane opens the lane first
function _transectOpenUnitOfHash() {
  var hash = location.hash;
  if (!hash) return;
  var target = document.getElementById(hash.slice(1));
  var unit = target && target.closest ? target.closest("details.transcript") : null;
  if (unit) unit.open = true;
}
window.addEventListener("hashchange", _transectOpenUnitOfHash);
document.addEventListener("DOMContentLoaded", _transectOpenUnitOfHash);

// Static layer tables (.relmap.sortable): click a header to sort by
// that column, numeric when every cell parses, click again to reverse.
function _transectSortTable(th) {
  var table = th.closest("table");
  var idx = Array.prototype.indexOf.call(th.parentNode.children, th);
  var tbody = table.tBodies[0];
  var rows = Array.prototype.slice.call(tbody.rows);
  var asc = th.getAttribute("data-sort") !== "asc";
  var values = rows.map(function(r) { return r.cells[idx] ? r.cells[idx].textContent.trim() : ""; });
  var numeric = values.every(function(v) { return v === "" || !isNaN(parseFloat(v.replace(/,/g, ""))); });
  rows.sort(function(a, b) {
    var va = a.cells[idx] ? a.cells[idx].textContent.trim() : "";
    var vb = b.cells[idx] ? b.cells[idx].textContent.trim() : "";
    var cmp = numeric
      ? (parseFloat(va.replace(/,/g, "")) || 0) - (parseFloat(vb.replace(/,/g, "")) || 0)
      : va.localeCompare(vb);
    return asc ? cmp : -cmp;
  });
  rows.forEach(function(r) { tbody.appendChild(r); });
  Array.prototype.forEach.call(th.parentNode.children, function(h) { h.removeAttribute("data-sort"); });
  th.setAttribute("data-sort", asc ? "asc" : "desc");
}

// The episode chart: drawn here from the JSON in #<id>-data (see
// report/episode.py). x is the compressed axis in seconds; segments map
// it back to real seconds since episode start for the labels. Wheel
// zooms about the cursor, drag pans, double-click resets.
var _episodes = {};
function _transectEpisode(id) {
  var root = document.getElementById(id);
  var data = JSON.parse(document.getElementById(id + "-data").textContent);
  var st = {id: id, root: root, data: data, d0: 0, d1: data.span, drag: null};
  _episodes[id] = st;
  var svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
  svg.setAttribute("role", "img");
  svg.setAttribute("aria-label", "Episode timeline");
  root.insertBefore(svg, root.firstChild);
  st.svg = svg;
  svg.addEventListener("wheel", function(e) {
    e.preventDefault();
    var g = _epGeom(st);
    var px = _epMouseX(st, e);
    var frac = Math.min(1, Math.max(0, (px - g.left) / g.plotW));
    var cursor = st.d0 + frac * (st.d1 - st.d0);
    var k = Math.exp(e.deltaY * 0.0015);
    var w = Math.min(st.data.span, Math.max(2, (st.d1 - st.d0) * k));
    _epSetWindow(st, cursor - frac * w, cursor - frac * w + w);
  }, {passive: false});
  svg.addEventListener("mousedown", function(e) {
    if (e.button !== 0) return;
    e.preventDefault();  // no text selection while dragging
    var px = _epMouseX(st, e);
    var handle = e.target.getAttribute && e.target.getAttribute("data-nav");
    if (handle === "left" || handle === "right") {
      st.drag = {mode: handle, d0: st.d0, d1: st.d1};
    } else if (handle === "thumb") {
      st.drag = {mode: "thumb", x: px, d0: st.d0, d1: st.d1};
    } else if (handle === "track") {
      // click outside the thumb: centre the window there
      var w0 = st.d1 - st.d0, c0 = _epNavV(st, px);
      _epSetWindow(st, c0 - w0 / 2, c0 + w0 / 2);
      st.drag = {mode: "thumb", x: px, d0: st.d0, d1: st.d1};
    } else {
      st.drag = {mode: "pan", x: px, d0: st.d0, d1: st.d1};
    }
    svg.classList.add("panning");
  });
  window.addEventListener("mousemove", function(e) {
    if (!st.drag) return;
    var g = _epGeom(st), px = _epMouseX(st, e), dr = st.drag;
    if (dr.mode === "pan") {
      var w = dr.d1 - dr.d0;
      var dx = (px - dr.x) / g.plotW * w;
      _epSetWindow(st, dr.d0 - dx, dr.d1 - dx);
    } else if (dr.mode === "thumb") {
      var wt = dr.d1 - dr.d0;
      var dv = (px - dr.x) / g.plotW * st.data.span;
      _epSetWindow(st, dr.d0 + dv, dr.d1 + dv);
    } else if (dr.mode === "left") {
      _epSetWindow(st, Math.min(_epNavV(st, px), dr.d1 - 2), dr.d1);
    } else if (dr.mode === "right") {
      _epSetWindow(st, dr.d0, Math.max(_epNavV(st, px), dr.d0 + 2));
    }
  });
  window.addEventListener("mouseup", function() { st.drag = null; svg.classList.remove("panning"); });
  svg.addEventListener("dblclick", function() { _transectEpisodeReset(id); });
  var tip = root.querySelector(".tip");
  svg.addEventListener("mousemove", function(e) {
    var el = e.target.closest ? e.target.closest("[data-tip]") : null;
    if (!el) { tip.style.display = "none"; return; }
    tip.textContent = el.getAttribute("data-tip");
    tip.style.display = "block";
    var r = root.getBoundingClientRect();
    var x = e.clientX - r.left + 14, y = e.clientY - r.top + 14;
    if (x + tip.offsetWidth > r.width) x = Math.max(0, e.clientX - r.left - tip.offsetWidth - 14);
    tip.style.left = x + "px"; tip.style.top = y + "px";
  });
  svg.addEventListener("mouseleave", function() { tip.style.display = "none"; });
  _epRender(st);
}
function _transectEpisodeReset(id) {
  var st = _episodes[id]; if (!st) return;
  _epSetWindow(st, 0, st.data.span);
}
function _epGeom(st) {
  var W = 1180, LEFT = 150, RIGHT = 24, TOP = 34, ROW = 28, GAPS = 22, NAV = 18, BOTTOM = 10;
  var n = st.data.lanes.length;
  var lanesEnd = TOP + ROW * n;
  return {W: W, left: LEFT, right: RIGHT, top: TOP, row: ROW, plotW: W - LEFT - RIGHT,
          lanesEnd: lanesEnd, navY: lanesEnd + GAPS, navH: NAV,
          H: lanesEnd + GAPS + NAV + BOTTOM, n: n};
}
// navigator: the whole span mapped onto the plot width
function _epNavX(st, v) { var g = _epGeom(st); return g.left + v / st.data.span * g.plotW; }
function _epNavV(st, px) { var g = _epGeom(st); return Math.max(0, Math.min(st.data.span, (px - g.left) / g.plotW * st.data.span)); }
function _epSetWindow(st, d0, d1) {
  var span = st.data.span, minW = 2;
  if (d1 - d0 < minW) { var c = (d0 + d1) / 2; d0 = c - minW / 2; d1 = c + minW / 2; }
  if (d0 < 0) { d1 -= d0; d0 = 0; }
  if (d1 > span) { d0 -= d1 - span; d1 = span; }
  st.d0 = Math.max(0, d0); st.d1 = Math.min(span, d1);
  _epRender(st);
}
function _epMouseX(st, e) {
  var r = st.svg.getBoundingClientRect();
  var g = _epGeom(st);
  return (e.clientX - r.left) / r.width * g.W;
}
function _epReal(st, x) {
  var segs = st.data.segments;
  for (var i = 0; i < segs.length; i++) {
    if (x <= segs[i].a1) return segs[i].r0 + Math.max(0, x - segs[i].a0);
  }
  var last = segs[segs.length - 1];
  return last ? last.r0 + (last.a1 - last.a0) : x;
}
function _epLabel(s) {
  s = Math.round(s);
  if (s >= 3600) return Math.floor(s / 3600) + "h" + ("0" + Math.floor((s % 3600) / 60)).slice(-2) + "m";
  return Math.floor(s / 60) + ":" + ("0" + (s % 60)).slice(-2);
}
function _epEsc(t) {
  return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
}
function _epRender(st) {
  var g = _epGeom(st), d = st.data, d0 = st.d0, d1 = st.d1, w = d1 - d0;
  var x = function(v) { return g.left + (v - d0) / w * g.plotW; };
  var out = [];
  out.push('<defs><clipPath id="' + st.id + '-clip"><rect x="' + g.left + '" y="0" width="' + g.plotW + '" height="' + g.H + '"/></clipPath></defs>');
  // axis: nice ticks in axis seconds, labelled with the real offset
  var steps = [1, 2, 5, 10, 15, 30, 60, 120, 300, 600, 900, 1800, 3600, 7200];
  var step = steps[steps.length - 1];
  for (var i = 0; i < steps.length; i++) { if (w / steps[i] <= 14) { step = steps[i]; break; } }
  out.push('<line x1="' + g.left + '" x2="' + (g.W - g.right) + '" y1="' + (g.top - 6) + '" y2="' + (g.top - 6) + '" stroke="currentColor" stroke-opacity="0.4"/>');
  out.push('<text x="8" y="' + (g.top - 12) + '" fill="currentColor" fill-opacity="0.7" font-size="10">start ' + _epEsc(d.start) + (d.gaps.length ? " (gaps collapsed)" : "") + "</text>");
  for (var t = Math.ceil(d0 / step) * step; t <= d1; t += step) {
    var px = x(t);
    out.push('<line x1="' + px.toFixed(1) + '" x2="' + px.toFixed(1) + '" y1="' + (g.top - 6) + '" y2="' + g.lanesEnd + '" stroke="currentColor" stroke-opacity="0.07"/>');
    out.push('<text x="' + px.toFixed(1) + '" y="' + (g.top - 12) + '" text-anchor="middle" font-size="10" fill="currentColor" fill-opacity="0.8">+' + _epLabel(_epReal(st, t)) + "</text>");
  }
  out.push('<g clip-path="url(#' + st.id + '-clip)">');
  d.gaps.forEach(function(gp) {
    if (gp.x < d0 || gp.x > d1) return;
    var px = x(gp.x);
    out.push('<line x1="' + px.toFixed(1) + '" x2="' + px.toFixed(1) + '" y1="' + (g.top - 4) + '" y2="' + g.lanesEnd + '" stroke="#999" stroke-dasharray="3,3"/>');
    out.push('<text x="' + px.toFixed(1) + '" y="' + (g.lanesEnd + 12) + '" text-anchor="middle" font-size="10" fill="#777">' + _epEsc(gp.label) + "</text>");
  });
  d.lanes.forEach(function(lane, i) {
    var mid = g.top + i * g.row + g.row / 2;
    out.push('<line x1="' + g.left + '" x2="' + (g.W - g.right) + '" y1="' + mid + '" y2="' + mid + '" stroke="currentColor" stroke-opacity="0.12"/>');
  });
  var minW = w / g.plotW * 1.5;
  d.turns.forEach(function(tn) {
    if (tn.x2 < d0 || tn.x1 > d1) return;
    var top = g.top + tn.row * g.row;
    var x1 = x(tn.x1), x2 = x(Math.max(tn.x2, tn.x1 + minW));
    out.push('<rect x="' + x1.toFixed(1) + '" y="' + (top + 7) + '" width="' + Math.max(1.5, x2 - x1).toFixed(1) + '" height="14" rx="1" fill="' + tn.color + '" stroke="#fff" stroke-width="0.5" data-tip="' + _epEsc(tn.tip) + '"/>');
  });
  d.points.forEach(function(pt) {
    if (pt.x < d0 || pt.x > d1) return;
    var top = g.top + pt.row * g.row, px = x(pt.x);
    if (pt.kind === "delivery") {
      out.push('<path d="M' + (px - 4).toFixed(1) + ',' + (top + 1) + ' L' + (px + 4).toFixed(1) + ',' + (top + 1) + ' L' + px.toFixed(1) + ',' + (top + 7) + ' Z" fill="' + pt.color + '" data-tip="' + _epEsc(pt.tip) + '"/>');
    } else if (pt.kind === "message") {
      out.push('<line x1="' + px.toFixed(1) + '" x2="' + px.toFixed(1) + '" y1="' + (top + 3) + '" y2="' + (top + 14) + '" stroke="' + pt.color + '" stroke-width="2.5" data-tip="' + _epEsc(pt.tip) + '"/>');
    } else {
      out.push('<circle cx="' + px.toFixed(1) + '" cy="' + (top + 21) + '" r="2.6" fill="' + pt.color + '" data-tip="' + _epEsc(pt.tip) + '"/>');
    }
  });
  out.push("</g>");
  // the navigator: the whole episode, a thumb over the visible window
  // with handles at its ends (drag the thumb to pan, a handle to zoom)
  var ny = g.navY, nh = g.navH;
  out.push('<rect x="' + g.left + '" y="' + ny + '" width="' + g.plotW + '" height="' + nh + '" rx="3" fill="#f1f3f5" stroke="#dee2e6" data-nav="track"/>');
  d.turns.forEach(function(tn) {
    var nx = _epNavX(st, tn.x1);
    out.push('<line x1="' + nx.toFixed(1) + '" x2="' + nx.toFixed(1) + '" y1="' + (ny + 3) + '" y2="' + (ny + nh - 3) + '" stroke="' + tn.color + '" stroke-opacity="0.35" pointer-events="none"/>');
  });
  var tx0 = _epNavX(st, d0), tx1 = Math.max(_epNavX(st, d1), tx0 + 8);
  out.push('<rect x="' + tx0.toFixed(1) + '" y="' + ny + '" width="' + (tx1 - tx0).toFixed(1) + '" height="' + nh + '" rx="3" fill="#104D6A" fill-opacity="0.18" stroke="#104D6A" stroke-opacity="0.6" data-nav="thumb" style="cursor:grab"/>');
  out.push('<rect x="' + (tx0 - 3).toFixed(1) + '" y="' + (ny - 2) + '" width="7" height="' + (nh + 4) + '" rx="2" fill="#104D6A" data-nav="left" style="cursor:ew-resize"/>');
  out.push('<rect x="' + (tx1 - 4).toFixed(1) + '" y="' + (ny - 2) + '" width="7" height="' + (nh + 4) + '" rx="2" fill="#104D6A" data-nav="right" style="cursor:ew-resize"/>');
  out.push('<text x="' + (g.left - 8) + '" y="' + (ny + nh - 5) + '" text-anchor="end" font-size="10" fill="currentColor" fill-opacity="0.6">navigator</text>');
  d.lanes.forEach(function(lane, i) {
    var mid = g.top + i * g.row + g.row / 2 + 4;
    var label = lane.kind === "agent" ? lane.name : lane.name + " (world)";
    if (lane.anchor) {
      out.push('<a href="#' + lane.anchor + '" onclick="_transectOpenUnit(\'' + lane.anchor + '\')"><text x="8" y="' + mid + '" font-size="11" fill="#104D6A" text-decoration="underline">' + _epEsc(label) + "</text></a>");
    } else {
      out.push('<text x="8" y="' + mid + '" font-size="11" fill="currentColor">' + _epEsc(label) + "</text>");
    }
  });
  st.svg.setAttribute("viewBox", "0 0 " + g.W + " " + g.H);
  st.svg.innerHTML = out.join("");
  var range = document.getElementById(st.id + "-range");
  if (range) {
    range.textContent = (w >= d.span - 0.5)
      ? "whole episode"
      : "showing +" + _epLabel(_epReal(st, d0)) + " to +" + _epLabel(_epReal(st, d1));
  }
}

// Band chunks link to their phase card (href target="_parent", ids
// transcript-scoped "#phase-<idx>-<n>"). Fragment navigation scrolls;
// this additionally opens the target <details> (native auto-open is
// not yet universal). The "#phase-" prefix check matches either id
// shape without parsing it.
function _transectOpenPhaseFromHash() {
  var hash = location.hash;
  if (!hash || hash.indexOf("#phase-") !== 0) return;
  var target = document.getElementById(hash.slice(1));
  if (!target) return;
  // A card filter may have hidden the target (a hidden anchor is a
  // link to nowhere): clear that card scope's filters first. Done on
  // hashchange because the click originates inside the band's iframe.
  if (target.style.display === "none") {
    var scope = target.closest(".phase-cards");
    if (scope) _transectClearCardFilters(scope.id);
  }
  if (target.tagName === "DETAILS") target.open = true;
  target.scrollIntoView({behavior: "smooth", block: "start"});
}
window.addEventListener("hashchange", _transectOpenPhaseFromHash);
document.addEventListener("DOMContentLoaded", _transectOpenPhaseFromHash);

// Sort/filter handlers for the phase cards (".filter-bar[data-scope]"
// + "div.phase-cards#<scope>"). Every lookup is scoped to one
// containerId so multiple transcripts on one page cannot cross-filter.
function _transectCardSort(containerId, by) {
  var c = document.getElementById(containerId);
  if (!c) return;
  var cards = Array.prototype.slice.call(c.querySelectorAll(".event"));
  // Always re-sort from data-order (this card's render-time,
  // chronological/phase_index position) first, regardless of the DOM's
  // current order - so repeated calls are idempotent (a "chronological"
  // pick after a "spend" pick genuinely restores phase order, not just
  // whatever the DOM happens to be in already) and so a "spend" sort's
  // own ties break chronologically (Array.sort is spec-guaranteed stable
  // in every evergreen browser, so this second sort's ties keep the
  // order the first sort just established).
  cards.sort(function(a, b) {
    return (parseFloat(a.getAttribute("data-order")) || 0)
         - (parseFloat(b.getAttribute("data-order")) || 0);
  });
  if (by === "spend" || by === "tools") {
    var attr = by === "spend" ? "data-spend" : "data-tools";
    cards.sort(function(a, b) {
      return (parseFloat(b.getAttribute(attr)) || 0)
           - (parseFloat(a.getAttribute(attr)) || 0);
    });
  }
  cards.forEach(function(el) { c.appendChild(el); });
}

// Label filter = per-label checkboxes (all checked = all shown);
// confidence bands: high >= 0.8, low < 0.6 (the scanner's own
// low-confidence trigger). A card with no recorded confidence fails
// BOTH bands when one is active - absence is not evidence of either.
function _transectLabelChecks(containerId) {
  var bar = document.querySelector('.filter-bar[data-scope="' + containerId + '"]');
  return bar
    ? Array.prototype.slice.call(bar.querySelectorAll("input[data-label-value]"))
    : [];
}

function _transectTagSelects(containerId) {
  var bar = document.querySelector('.filter-bar[data-scope="' + containerId + '"]');
  return bar
    ? Array.prototype.slice.call(bar.querySelectorAll("select[data-tag-family]"))
    : [];
}

function _transectCardFilter(containerId) {
  var c = document.getElementById(containerId);
  if (!c) return;
  var checks = _transectLabelChecks(containerId);
  var tagSelects = _transectTagSelects(containerId);
  var allowed = {};
  checks.forEach(function(el) {
    if (el.checked) allowed[el.getAttribute("data-label-value")] = true;
  });
  var flushEl = document.getElementById(containerId + "-flush");
  var intvEl = document.getElementById(containerId + "-intv");
  var subagEl = document.getElementById(containerId + "-subag");
  var confEl = document.getElementById(containerId + "-conf");
  var wantFlush = !!(flushEl && flushEl.checked);
  var wantIntv = !!(intvEl && intvEl.checked);
  var wantSubag = !!(subagEl && subagEl.checked);
  var confBand = confEl ? confEl.value : "";
  var cards = c.querySelectorAll(".event");
  var shown = 0;
  cards.forEach(function(card) {
    var okLabel = checks.length === 0 || !!allowed[card.getAttribute("data-label")];
    var okFlush = !wantFlush || card.getAttribute("data-after-flush") === "1";
    var okIntv = !wantIntv || card.getAttribute("data-after-intervention") === "1";
    var okSubag = !wantSubag
      || (parseFloat(card.getAttribute("data-subagents")) || 0) > 0;
    var okConf = true;
    if (confBand) {
      var conf = parseFloat(card.getAttribute("data-confidence"));
      okConf = confBand === "high" ? conf >= 0.8 : conf < 0.6;
      if (isNaN(conf)) okConf = false;
    }
    // every active tag selector must match one of the card's own
    // "|family=value|" keys (data-tags, fenced against prefix collisions)
    var okTags = tagSelects.every(function(sel) {
      if (!sel.value) return true;
      var key = "|" + sel.getAttribute("data-tag-family") + "=" + sel.value + "|";
      return (card.getAttribute("data-tags") || "").indexOf(key) >= 0;
    });
    var visible = okLabel && okFlush && okIntv && okSubag && okConf && okTags;
    card.style.display = visible ? "" : "none";
    if (visible) shown++;
  });
  var count = document.getElementById(containerId + "-count");
  if (count) count.textContent = "showing " + shown + " of " + cards.length + " phases";
  var empty = document.getElementById(containerId + "-empty");
  if (empty) empty.hidden = shown > 0;
}

function _transectClearCardFilters(containerId) {
  _transectLabelChecks(containerId).forEach(function(el) { el.checked = true; });
  var flushEl = document.getElementById(containerId + "-flush");
  var intvEl = document.getElementById(containerId + "-intv");
  var subagEl = document.getElementById(containerId + "-subag");
  var confEl = document.getElementById(containerId + "-conf");
  if (flushEl) flushEl.checked = false;
  if (intvEl) intvEl.checked = false;
  if (subagEl) subagEl.checked = false;
  if (confEl) confEl.value = "";
  _transectTagSelects(containerId).forEach(function(sel) { sel.value = ""; });
  _transectCardFilter(containerId);
}

// Token spend: the custom-grouping selector shows one tag family's
// chart at a time (each family's chart is its own hidden-able div).
function _transectSpendFamily(scope, family) {
  document.querySelectorAll('[data-spend-scope="' + scope + '"]').forEach(function(el) {
    el.hidden = el.getAttribute("data-spend-family") !== family;
  });
}

// initial "showing N of M phases" line for every transcript's bar (also
// covers the no-JS-yet-run window right after load, before any control
// is touched).
function _transectInitCardFilters() {
  document.querySelectorAll(".filter-bar[data-scope]").forEach(function(bar) {
    _transectCardFilter(bar.getAttribute("data-scope"));
  });
}
document.addEventListener("DOMContentLoaded", _transectInitCardFilters);

// Publish each chart iframe's visible box ("left,top,right,bottom",
// in the iframe's own coordinates) so the in-iframe tooltip clamp can
// keep popovers inside what the reader actually sees: a scrolled
// wrapper shows only a sub-box of the iframe. The outer page owns the
// wrapper and window, so it measures; the child reads the attribute.
// Absent or stale, the child falls back to its whole viewport.
function _transectChartVisibleBounds() {
  document.querySelectorAll("div.chart-scroll > iframe").forEach(function(frame) {
    var scroller = frame.parentElement;
    var f = frame.getBoundingClientRect();
    var s = scroller.getBoundingClientRect();
    // Under the fit transform, getBoundingClientRect is in scaled
    // screen px but the child reads unscaled coordinates: divide the
    // screen-space terms by the effective scale (rect/layout width;
    // exactly 1 untransformed).
    var k = frame.clientWidth ? f.width / frame.clientWidth : 1;
    var box = [
      Math.max(0, (s.left - f.left) / k, -f.left / k),
      Math.max(0, (s.top - f.top) / k, -f.top / k),
      Math.min(frame.clientWidth, (s.right - f.left) / k,
               (window.innerWidth - f.left) / k),
      Math.min(frame.clientHeight, (s.bottom - f.top) / k,
               (window.innerHeight - f.top) / k)
    ];
    frame.setAttribute("data-transect-visible", box.map(Math.round).join(","));
    // Keep each chart's input widgets visible while the zoomed view
    // scrolls horizontally. Widgets live inside the iframe document (a
    // Mosaic Param/Selection cannot cross the boundary) and the whole
    // document is moved by the wrapper's scroll, so position:sticky is
    // inert - translate the widget rows by scrollLeft instead (0 in
    // the default fit view).
    var inner = frame.contentDocument;
    if (inner) {
      var shift = scroller.scrollLeft / (k || 1);
      // a widget ROW is the ancestor of a control (radio fieldset,
      // tom-select, checkbox) sitting directly under the container
      // that also holds the plot svgs - the .mosaic-widget root is
      // one element wrapping everything, so climb instead of class-match
      var rows = [];
      inner.querySelectorAll("fieldset, .ts-wrapper, input[type=checkbox]")
        .forEach(function(el) {
          var n = el;
          while (n.parentElement && !n.parentElement.querySelector("svg")) {
            n = n.parentElement;
          }
          if (n.parentElement && rows.indexOf(n) < 0) rows.push(n);
        });
      rows.forEach(function(row) {
        row.style.transform = shift > 0.5 ? "translateX(" + shift + "px)" : "";
      });
    }
  });
}

// Every chart iframe optically scales down to its wrapper's width
// (default view; the zoom checkbox restores authored width + h-scroll).
// A transform does not change layout, so the wrapper gets an explicit
// height and hides both overflow axes (hidden-x flips visible-y to
// auto, which grew phantom scrollbars). Charts that already fit stay
// at authored size (k caps at 1). Re-applied on resize.
function _transectApplyFit() {
  var zoom = document.getElementById("transect-zoom-toggle");
  var zoomed = !!(zoom && zoom.checked);
  document.querySelectorAll("div.chart-scroll > iframe").forEach(function(frame) {
    var wrap = frame.parentElement;
    var k = !zoomed && frame.clientWidth
      ? Math.min(1, wrap.clientWidth / frame.clientWidth) : 1;
    if (k >= 1) {
      frame.style.transform = "";
      frame.style.transformOrigin = "";
      wrap.style.height = "";
      // restore, not clear: the wrapper's overflow-x:auto is an INLINE
      // style from charts.embed, so writing "" here would erase it and
      // leave the default (visible) - wide charts would then overflow
      // the page body itself.
      wrap.style.overflowX = "auto";
      wrap.style.overflowY = "";
      return;
    }
    wrap.scrollLeft = 0;
    wrap.scrollTop = 0;
    frame.style.transformOrigin = "0 0";
    frame.style.transform = "scale(" + k + ")";
    wrap.style.height = (frame.clientHeight * k) + "px";
    // both axes: the iframe's LAYOUT box keeps its unscaled size (a
    // transform is visual-only), so with only overflow-x hidden the
    // wrapper grows a vertical scrollbar for layout the reader can
    // never see (hidden on one axis computes the other's visible to
    // auto) - hide both; the scaled chart fits the wrapper's own box
    // exactly by construction.
    wrap.style.overflowX = "hidden";
    wrap.style.overflowY = "hidden";
  });
  _transectQueueVisibleBounds();
}
var _transectFitPending = false;
function _transectQueueFit() {
  if (_transectFitPending) return;
  _transectFitPending = true;
  requestAnimationFrame(function() {
    _transectFitPending = false;
    _transectApplyFit();
  });
}
document.addEventListener("DOMContentLoaded", _transectApplyFit);
window.addEventListener("load", _transectApplyFit);
window.addEventListener("resize", _transectQueueFit);

// "Back to top" visibility: appears once the reader is a screen down
// (covers both plain scrolling and a band click-to-card jump).
function _transectBackTopVisibility() {
  var el = document.getElementById("transect-back-top");
  if (el) el.style.display = window.scrollY > window.innerHeight ? "block" : "none";
}
window.addEventListener("scroll", _transectBackTopVisibility);
document.addEventListener("DOMContentLoaded", _transectBackTopVisibility);
// coalesced to one pass per frame: scroll/resize fire far faster than
// layout needs re-measuring, and this runs in the top document where
// requestAnimationFrame is never throttled.
var _transectBoundsPending = false;
function _transectQueueVisibleBounds() {
  if (_transectBoundsPending) return;
  _transectBoundsPending = true;
  requestAnimationFrame(function() {
    _transectBoundsPending = false;
    _transectChartVisibleBounds();
  });
}
document.addEventListener("DOMContentLoaded", _transectChartVisibleBounds);
window.addEventListener("load", _transectChartVisibleBounds);
// capture phase: a wrapper's own scroll event does not bubble to window
window.addEventListener("scroll", _transectQueueVisibleBounds, true);
window.addEventListener("resize", _transectQueueVisibleBounds);
</script>
</body></html>
